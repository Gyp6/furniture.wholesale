{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "Lab 5: Mutation Score as the compensating metric for Line Coverage (Goodhart). Pinned versions in package.json.",
  "packageManager": "npm",
  "testRunner": "command",
  "commandRunner": { "command": "bun test src/infrastructure/fx src/modules/catalog/infrastructure/api/price-list.resilience.spec.ts" },
  "mutate": [
    "src/infrastructure/fx/**/*.ts",
    "!src/infrastructure/fx/**/*.spec.ts",
    "!src/infrastructure/fx/index.ts",
    "!src/infrastructure/fx/fx.module.ts",
    "src/modules/catalog/application/services/price-list.service.ts"
  ],
  "coverageAnalysis": "off",
  "concurrency": 2,
  "timeoutMS": 15000,
  "reporters": ["clear-text", "progress", "json", "html"],
  "jsonReporter": { "fileName": "reports/mutation/mutation.json" },
  "htmlReporter": { "fileName": "reports/mutation/mutation.html" },
  "thresholds": { "high": 80, "low": 65, "break": 65 },
  "ignorePatterns": ["dist", "coverage", "reports", ".scannerwork"]
}
