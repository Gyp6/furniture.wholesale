{
  "name": "furniture.wholesale",
  "version": "1.0.0",
  "description": "furniture wholesale",
  "author": "@Gyp6.sale",
  "license": "Apache-2.0",
  "directories": {
    "doc": "docs",
    "server": "server",
    "client": "client",
    "deploy": "deploy"
  },
  "scripts": {
    "prepare": "husky",
    "sonar": "powershell -ExecutionPolicy Bypass -File scripts/sonar-scan.ps1",
    "lab2:up": "docker compose -f deploy/lab2/docker-compose.yaml up -d --build",
    "lab2:down": "docker compose -f deploy/lab2/docker-compose.yaml down -v",
    "perf:normal": "k6 run -e PROFILE=normal perf/price-list.k6.js",
    "perf:peak": "k6 run -e PROFILE=peak perf/price-list.k6.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gyp6/furniture.wholesale.git"
  },
  "keywords": [],
  "bugs": {
    "url": "https://github.com/Gyp6/furniture.wholesale/issues"
  },
  "homepage": "https://github.com/Gyp6/furniture.wholesale#readme",
  "dependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0"
  }
}
