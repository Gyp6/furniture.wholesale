GOOGLE_CLIENT_ID=x
GOOGLE_CLIENT_SECRET=x
FACEBOOK_CLIENT_ID=x
FACEBOOK_CLIENT_SECRET=x
APPLE_CLIENT_ID=x
APPLE_CLIENT_SECRET=x

# External dependency: NBU exchange-rate API (fake server inside the stand)
FX_API_URL=http://fake-nbu:4300/NBUStatService/v1/statdirectory/exchange
FX_TIMEOUT_MS=500
FX_MAX_ATTEMPTS=3
FX_RETRY_BASE_MS=100
FX_RETRY_MAX_MS=1000
