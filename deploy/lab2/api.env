# Lab 2 test stand — local, non-secret values only
NODE_ENV=production
HTTP_PORT=4200
HTTP_HOST=http://localhost:4200
HTTP_CORS=http://localhost:3000
BACKEND_URL=http://localhost:4200
FRONTEND_URL=http://localhost:3000
JWT_SECRET=lab2-local-secret
BETTER_AUTH_SECRET=lab2-local-better-auth-secret-0001
